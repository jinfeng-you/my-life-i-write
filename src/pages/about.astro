---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="关于 — my life I write">
  <section class="view" data-view="about">
    <header class="view__head">
      <div>
        <p class="eyebrow">04 — 关于 / About</p>
        <h2 class="view__title">关于</h2>
      </div>
      <p class="view__note">以及留言</p>
    </header>

    <div class="about">
      <div class="about__col">
        <p class="eyebrow">关于本站</p>
        <blockquote class="intro intro--about">
          <p>很多年以后我们也许不在了，<br />所以趁现在，留下一些东西吧～。</p>
        </blockquote>
        <dl class="contact">
          <div><dt>邮箱</dt><dd><a class="contact__mail" href="mailto:jinfeng.you@outlook.com">jinfeng.you@outlook.com</a></dd></div>
          <div><dt>社交</dt><dd>待补</dd></div>
          <div><dt>RSS</dt><dd>待补</dd></div>
        </dl>
      </div>

      <div class="about__col">
        <p class="eyebrow">留言</p>
        <form class="form" data-msg-form novalidate>
          <label class="field"><span>名字</span><input autocomplete="name" maxlength="20" name="name" placeholder="怎么称呼" type="text" /></label>
          <label class="field"><span>想说的话</span><textarea maxlength="300" name="text" placeholder="写点什么，大家都能看到。" rows="4"></textarea></label>
          <button class="btn" type="submit">留下</button>
          <p class="form__hint" data-msg-hint role="status">留言会保存到本站数据库，所有访问者都可以看到。</p>
        </form>
        <ol class="msgs" data-msgs></ol>
        <p class="msgs__empty" data-msgs-empty>还没有留言。你可以写第一条。</p>
      </div>
    </div>
  </section>
</BaseLayout>
