---
import BaseLayout from '../../layouts/BaseLayout.astro';
import AttachmentList from '../../components/AttachmentList.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const articles = await getCollection('articles');
  return articles.filter(a => !a.data.draft).map(article => ({ params: { id: article.id }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
const date = article.data.date.toISOString().slice(0,10).replaceAll('-', '.');
---
<BaseLayout title={`${article.data.title} — my life I write`} description={article.data.excerpt || article.data.title} reading>
  <section class="view" data-view="article">
    <article class="piece">
      <a class="back" href="/writing/"><span aria-hidden="true">←</span> 文章</a>
      <header class="piece__head">
        <p class="piece__meta"><span class="tag">{article.data.category}</span><time>{date}</time></p>
        <h1 class="piece__title">{article.data.title}</h1>
      </header>
      <div class="piece__body article-content" data-annotation-post={`article:${article.id}`} data-annotation-title={article.data.title}>
        <Content />
      </div>
      <AttachmentList attachments={article.data.attachments} />

      <div class="react" data-react="article" data-stat-key={`article:${article.id}`}>
        <button class="react__like" data-like type="button" aria-label="为这篇文章点赞" aria-pressed="false">
          <svg class="react__heart" aria-hidden="true" focusable="false" viewBox="0 0 24 24"><path d="M12 20.3 5.4 13.9a4.4 4.4 0 0 1 6.6-5.7 4.4 4.4 0 0 1 6.6 5.7Z"></path></svg>
          <span data-likes>0</span>
        </button>
        <span class="react__views"><span data-views>0</span> 次阅读</span>
      </div>

      <section class="annotations" data-annotations-panel hidden>
        <div class="annotations__head">
          <span class="eyebrow">读者想法</span>
          <button type="button" class="annotations__close" data-annotations-close>关闭</button>
        </div>
        <div data-annotations-list></div>
      </section>

      <footer class="piece__foot">
        <span>{article.data.title}</span>
        <a href="/writing/">回到文章列表</a>
      </footer>
    </article>
  </section>
</BaseLayout>
